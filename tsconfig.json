{
  // Rules engine + game engine + their tests (run in Node). The server has its own config
  // (tsconfig.worker.json) because the Workers runtime types clash with Node's.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/rules", "src/game", "test/*.ts"]
}
